  "default_multimodal_model": "glm-4.6v-flash",
  "default_image_generate_model": "cogview-3-flash",
  "default_video_generate_model": "cogvideox-flash",
  "base_url": "",
  "ZHIPUAI_API_KEY": "your_api_key"
}
